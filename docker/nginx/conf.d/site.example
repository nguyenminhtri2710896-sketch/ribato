map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80;
    listen [::]:80;
    access_log /var/www/storage/logs/access.log;
    add_header X-Frame-Options SAMEORIGIN;
    add_header X-Content-Type-Options nosniff;
    add_header X-XSS-Protection "1; mode=block";
    root /var/www/public;
    index index.php index.html index.htm;
    server_name dev.wallet.com;

    # Chuyển hướng toàn bộ truy cập đến IP gốc
    # location / {
    #     proxy_http_version 1.1;
    #     proxy_set_header Host $http_host;
    #     proxy_set_header Scheme $scheme;
    #     proxy_set_header SERVER_PORT $server_port;
    #     proxy_set_header REMOTE_ADDR $remote_addr;
    #     proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    #     proxy_set_header Upgrade $http_upgrade;
    #     proxy_set_header Connection $connection_upgrade;
    #     proxy_pass http://workspace:8383;
    # }

    location / {
        if (!-f $request_filename) {
            rewrite ^(.*)$ /index.php?q=$1 last;
            break;
        }
    }

    client_max_body_size 300M;
    location ~ \.php$ {
        fastcgi_split_path_info ^(.+\.php)(/.+)$;
        include /etc/nginx/conf/fastcgi_params;
        fastcgi_pass php-fpm:9000;
        fastcgi_index index.php;
        fastcgi_connect_timeout 250;
        fastcgi_send_timeout 250;
        fastcgi_read_timeout 250;
        fastcgi_buffer_size 256k;
        fastcgi_buffers 4 256k;
        fastcgi_busy_buffers_size 556k;
        fastcgi_temp_file_write_size 556k;
        fastcgi_intercept_errors on;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
    }


    location /static/ {
        alias /var/www/static/;
        autoindex off;
        location ~* \.(eot|ttf|woff|otf|svg)$ {
            add_header "Access-Control-Allow-Origin" "*";
        }
        location ~* \.(3gp|gif|jpg|jpeg|png|ico|wmv|avi|asf|asx|mpg|mpeg|mp4|pls|mp3|mid|wav|swf|flv|exe|zip|tar|rar|gz|tgz|bz2|uha|7z|doc|docx|xls|xlsx|pdf|iso|eot|svg|ttf|woff)$ {

            gzip_static on;
            add_header Pragma public;
            add_header Cache-Control "public, must-revalidate, proxy-revalidate";
            access_log off;
            expires 30d;
            break;
        }

        location ~* \.(txt|js|css)$ {

            add_header Pragma public;
            add_header Cache-Control "public, must-revalidate, proxy-revalidate";
            access_log off;
            expires 30d;
            break;
        }
    }

    location /static/vendor/ {
        alias /var/www/public/vendor/;
        autoindex off;
        location ~* \.(eot|ttf|woff|otf|svg)$ {
            add_header "Access-Control-Allow-Origin" "*";
        }
        location ~* \.(3gp|gif|jpg|jpeg|png|ico|wmv|avi|asf|asx|mpg|mpeg|mp4|pls|mp3|mid|wav|swf|flv|exe|zip|tar|rar|gz|tgz|bz2|uha|7z|doc|docx|xls|xlsx|pdf|iso|eot|svg|ttf|woff)$ {

            gzip_static on;
            add_header Pragma public;
            add_header Cache-Control "public, must-revalidate, proxy-revalidate";
            access_log off;
            expires 30d;
            break;
        }

        location ~* \.(txt|js|css)$ {

            add_header Pragma public;
            add_header Cache-Control "public, must-revalidate, proxy-revalidate";
            access_log off;
            expires 30d;
            break;
        }
    }

    location /static/resize/ {
        expires 31536000s;
        proxy_set_header Pragma "public";
        proxy_set_header Cache-Control "max-age=31536000, public";
        resolver 8.8.8.8 ipv6=off; # Use Google for DNS.
        resolver_timeout 15s;
        proxy_cache_key "$scheme$request_method$host$request_uri";
        proxy_cache_lock on;
        proxy_cache_valid 30d; # Cache valid thumbnails for 30 days.
        proxy_cache_valid any 15s; # Everything else gets 15s.
        proxy_cache_use_stale error timeout invalid_header updating;
        proxy_http_version 1.1;
        proxy_ignore_headers "Set-Cookie";
        proxy_hide_header "Set-Cookie";
        proxy_buffering on;


        location ~* /static/resize/(?<width>\d+)/(?<image>.+)$ {
            alias /var/www/static/$image;
            image_filter resize $width -;
            image_filter_jpeg_quality 75;
            image_filter_webp_quality 75;
            image_filter_buffer 20M;
            error_page 404 = /empty;
            error_page 521 = /empty;
            error_page 522 = /empty;
            error_page 415 = /empty;
            error_page 502 = /empty;
        }

        location ~* /static/resize/(?<width>\d+)x(?<height>\d+)/(?<image>.+) {
            alias /var/www/static/$image;
            image_filter_interlace on;
            image_filter_buffer 20M;
            image_filter_jpeg_quality 75;
            image_filter_webp_quality 75;
            image_filter crop $width $height;
            error_page 404 = /empty;
            error_page 521 = /empty;
            error_page 522 = /empty;
            error_page 415 = /empty;
            error_page 502 = /empty;
        }

        location ~* static/resize/(?<image>.+)$ {
            alias /var/www/static/$image;
            image_filter_buffer 20M;
            image_filter_jpeg_quality 75;
            image_filter_webp_quality 75;
            error_page 404 = /empty;
            error_page 521 = /empty;
            error_page 415 = /empty;
            error_page 522 = /empty;
            error_page 502 = /empty;
        }

    }
}